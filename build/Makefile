	$(MAKE) $(MAKESILENT) -f CMakeFiles/tcf_spmm_run.dir/build.make CMakeFiles/tcf_spmm_run.dir/src/tcf_spmm_main.cu.o
.PHONY : src/tcf_spmm_main.cu.o

src/tcf_spmm_main.i: src/tcf_spmm_main.cu.i
.PHONY : src/tcf_spmm_main.i

# target to preprocess a source file
src/tcf_spmm_main.cu.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tcf_spmm_run.dir/build.make CMakeFiles/tcf_spmm_run.dir/src/tcf_spmm_main.cu.i
.PHONY : src/tcf_spmm_main.cu.i

src/tcf_spmm_main.s: src/tcf_spmm_main.cu.s
.PHONY : src/tcf_spmm_main.s

# target to generate assembly for a file
src/tcf_spmm_main.cu.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tcf_spmm_run.dir/build.make CMakeFiles/tcf_spmm_run.dir/src/tcf_spmm_main.cu.s
.PHONY : src/tcf_spmm_main.cu.s

